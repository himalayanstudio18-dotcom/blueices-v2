# Public production site URL — used to build the canonical link and
# absolute Open Graph / Twitter image URLs in index.html (via Vite's
# %VITE_SITE_URL% HTML env-replacement, see index.html <head>).
#
# Not a secret: this is committed on purpose so `vite build` always
# produces valid, absolute metadata URLs, whether run on Vercel or
# locally. blueiceexplore.in is the connected custom domain (the
# apex 308-redirects here, per Vercel's domain config) — this is the
# single place to update if that domain ever changes.
VITE_SITE_URL=https://www.blueiceexplore.in
