# Copy this file to .env.local and fill in real values from your
# Supabase project (Settings > API). .env.local is gitignored — never
# commit real keys. Only the anon/public key belongs here; the
# service_role key must never be used in frontend code.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public production site URL (not a secret — actually committed, tracked,
# in .env.production). Drives the canonical link and Open Graph/Twitter
# image URLs in index.html. Update it there once a custom domain is live.
VITE_SITE_URL=https://your-domain.com
