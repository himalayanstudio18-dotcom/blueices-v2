# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env files (never commit real secrets; .env.example is the template and stays tracked)
.env
.env.*
!.env.example
# .env.production holds only the public production site URL (VITE_SITE_URL,
# used for canonical/Open Graph tags) — not a secret, so it stays tracked as
# the single place to update once a custom domain is connected in Vercel.
!.env.production

# Secrets
supabase credentials.txt

